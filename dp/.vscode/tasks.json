{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: build active file",
            "type": "shell",
            "command": "${workspaceFolder}/../.vscode/build_cpp.sh",
            "args": [
                "${file}",
                "${workspaceFolder}/.."
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "focus": true,
                "panel": "dedicated"
            },
            "detail": "Build the active C++ file into the repository .vscode/build directory."
        },
        {
            "label": "C++: run active file",
            "type": "shell",
            "command": "${workspaceFolder}/../.vscode/run_cpp.sh",
            "args": [
                "${file}",
                "${workspaceFolder}/.."
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "focus": true,
                "panel": "dedicated"
            },
            "detail": "Build and run the active C++ file."
        },
        {
            "label": "Python: run active file",
            "type": "shell",
            "command": "python3",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "clear": true,
                "focus": true,
                "panel": "dedicated"
            },
            "detail": "Run the active Python file with python3."
        }
    ]
}
