{
    "configurations": [
        {
            "name": "macOS",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/.vscode/include"
            ],
            "defines": [
                "LOCAL"
            ],
            "compilerPath": "/usr/bin/g++",
            "compilerArgs": [
                "-std=c++23",
                "-O2",
                "-I${workspaceFolder}/.vscode/include"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
